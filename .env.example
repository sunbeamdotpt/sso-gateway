# Copy this file to .env and replace every placeholder with cryptographically
# random values before running docker compose up.

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------

# Database owner used by Postgres and the Ory DSNs.
POSTGRES_USER=ory

# Password for the Postgres owner. Must be strong and unique.
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Postgres TLS mode for all DSNs. Use "require" or stronger in production.
# Local dev with a trusted certificate can use "verify-ca" or "verify-full".
POSTGRES_SSLMODE=require

# -----------------------------------------------------------------------------
# Ory Hydra
# -----------------------------------------------------------------------------

# System secret used to encrypt Hydra payloads (at least 16 bytes recommended).
HYDRA_SYSTEM_SECRET=change-me-to-a-long-random-value

# Pairwise subject identifier salt.
HYDRA_PAIRWISE_SALT=change-me-to-a-long-random-value

# -----------------------------------------------------------------------------
# Ory Kratos
# -----------------------------------------------------------------------------

# Secret used to sign and encrypt Kratos session cookies.
KRATOS_COOKIE_SECRET=change-me-to-a-long-random-value

# Kratos identity schema id the gateway uses in every identity payload. Kratos
# only ever knows this single base schema (the login contract: email as the
# password identifier, recovery/verification via email). Tenant schemas live in
# the gateway. Defaults to "default" if unset; production typically sets this to
# the pre-registered Kratos schema id (e.g. "employee").
KRATOS_DEFAULT_SCHEMA_ID=default

# -----------------------------------------------------------------------------
# SSO Gateway
# -----------------------------------------------------------------------------

# OAuth2 client secret for the system bootstrap client.
SYSTEM_BOOTSTRAP_CLIENT_SECRET=change-me-to-a-long-random-value

# Secret used by the gateway to sign state/pkce cookies (min 32 bytes).
STATE_COOKIE_SECRET=change-me-to-a-long-random-value-at-least-32-bytes

# Public URL of the UI application. Magic links in emails point here.
# Defaults to PUBLIC_BASE_URL if unset.
UI_PUBLIC_URL=https://app.example.com
